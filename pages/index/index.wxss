.page {
  padding-bottom: 180rpx;
}

/* ---------- 菜系：一行三个，按百分比等分，不受屏宽影响 ---------- */
.cuisines {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx 24rpx 4rpx;
}

.cuisine {
  width: 31.8%;
  margin-bottom: 18rpx;
  padding: 20rpx 16rpx 18rpx;
  background: #fffdfb;
  border-radius: 22rpx 22rpx 22rpx 8rpx;
  box-shadow:
    0 8rpx 20rpx rgba(186, 130, 120, 0.1),
    inset 0 0 0 2rpx #f6e5e2;
}

.cuisine.on {
  background: linear-gradient(150deg, #e9a8b2, #c96a7d);
  box-shadow: 0 14rpx 26rpx rgba(201, 106, 125, 0.3);
}

.cuisine-name {
  font-size: 30rpx;
  color: #43333a;
  letter-spacing: 2rpx;
  font-weight: 600;
  line-height: 1.3;
}

.cuisine.on .cuisine-name {
  color: #ffffff;
}

.cuisine-tag {
  margin-top: 8rpx;
  font-size: 19rpx;
  color: #ab979c;
  letter-spacing: 1rpx;
}

.cuisine.on .cuisine-tag {
  color: rgba(255, 255, 255, 0.82);
}

/* ---------- 分类 ---------- */
.cats {
  display: flex;
  flex-wrap: wrap;
  padding: 20rpx 24rpx 0;
}

/* ---------- 火锅：锅底一步 ---------- */
.base-block {
  margin: 22rpx 24rpx 6rpx;
  padding: 26rpx 0 24rpx;
  background: #fffdfb;
  border-radius: 28rpx;
  box-shadow:
    0 12rpx 30rpx rgba(186, 130, 120, 0.1),
    inset 0 0 0 2rpx #f8ece8;
}

.base-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 0 26rpx 20rpx;
}

.base-title {
  display: flex;
  align-items: center;
}

.base-step {
  font-size: 18rpx;
  color: #b25a6c;
  background: #fbebee;
  border-radius: 6rpx;
  padding: 4rpx 10rpx;
  margin-right: 12rpx;
  letter-spacing: 1rpx;
}

.base-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #43333a;
  letter-spacing: 2rpx;
}

.base-meta {
  font-size: 20rpx;
  color: #ab979c;
}

.base-list {
  display: flex;
  padding: 0 26rpx;
}

.base-card {
  flex: 1;
  min-width: 0;
  padding: 10rpx 10rpx 14rpx;
  margin-right: 12rpx;
  border-radius: 22rpx;
  background: #fffdfb;
  box-shadow: inset 0 0 0 2rpx #f4e7e2;
}

.base-card:last-child {
  margin-right: 0;
}

.base-card.on {
  background: #fdeff1;
  box-shadow: inset 0 0 0 3rpx #d98194;
}

.base-frame {
  position: relative;
  width: 100%;
  height: 132rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f6ece8;
}

.base-img {
  width: 100%;
  height: 100%;
}

.base-badge {
  position: absolute;
  right: 8rpx;
  top: 8rpx;
  min-width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 8rpx;
  text-align: center;
  border-radius: 999rpx;
  background: rgba(185, 93, 112, 0.95);
  color: #fff;
  font-size: 20rpx;
}

.base-cname {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #43333a;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.base-cmeta {
  margin-top: 4rpx;
  font-size: 18rpx;
  color: #ab979c;
}

.base-tip {
  margin: 18rpx 26rpx 0;
  padding: 12rpx 18rpx;
  font-size: 21rpx;
  color: #b25a6c;
  background: #fdeff1;
  border-radius: 12rpx;
  letter-spacing: 1rpx;
}
