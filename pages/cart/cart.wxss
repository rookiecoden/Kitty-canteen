.page {
  padding: 0 24rpx 230rpx;
}

/* ---------- 顶部引言 ---------- */
.intro {
  padding: 36rpx 8rpx 8rpx;
}

.intro-kicker {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #b25a6c;
  margin-bottom: 10rpx;
}

.kicker-star {
  color: #c9a063;
  margin-right: 10rpx;
}

.intro-title {
  font-size: 52rpx;
  color: #43333a;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.intro-sub {
  font-size: 23rpx;
  color: #a08a90;
  margin-top: 10rpx;
  letter-spacing: 1rpx;
}

.block {
  margin-top: 42rpx;
}

/* 火锅没锅底的提醒 */
.need-base {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
  padding: 20rpx 24rpx;
  background: #fdeff1;
  border-radius: 20rpx;
  box-shadow: inset 0 0 0 2rpx #f6d7dd;
}

.need-mark {
  width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  text-align: center;
  border-radius: 50%;
  background: #c96a7d;
  color: #fff;
  font-size: 22rpx;
  margin-right: 14rpx;
}

.need-text {
  flex: 1;
  font-size: 24rpx;
  color: #b25a6c;
  letter-spacing: 1rpx;
}

.need-link {
  font-size: 23rpx;
  color: #b25a6c;
  font-weight: 600;
}

.base-tag {
  display: inline-block;
  margin-left: 10rpx;
  padding: 2rpx 10rpx;
  font-size: 18rpx;
  border-radius: 6rpx;
  color: #fff;
  background: linear-gradient(135deg, #dd8e9c, #b95d70);
  vertical-align: middle;
}

.pad {
  padding: 32rpx 30rpx;
}

/* ---------- 菜品清单 ---------- */
.items {
  padding: 10rpx 26rpx 6rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.item-frame {
  width: 112rpx;
  height: 112rpx;
  padding: 5rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 6rpx 14rpx rgba(186, 130, 120, 0.14);
  flex-shrink: 0;
}

.item-img {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
  background: #f6ece8;
}

.item-body {
  flex: 1;
  padding-left: 20rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #43333a;
  letter-spacing: 1rpx;
}

.item-cal {
  font-size: 21rpx;
  color: #ab979c;
  margin-top: 6rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.step-btn {
  width: 54rpx;
  height: 54rpx;
  line-height: 50rpx;
  text-align: center;
  border-radius: 50%;
  font-size: 30rpx;
}

.step-btn.plus {
  background: linear-gradient(150deg, #f0b3bd, #cf6f81);
  color: #fff;
  box-shadow: 0 6rpx 14rpx rgba(207, 111, 129, 0.3);
}

.step-btn.minus {
  background: #fbebee;
  color: #b25a6c;
}

.step-num {
  min-width: 58rpx;
  text-align: center;
  font-size: 32rpx;
  color: #43333a;
}

.items-dash {
  margin: 6rpx 0 0;
}

.items-foot {
  display: flex;
  align-items: baseline;
  justify-content: flex-end;
  padding: 22rpx 4rpx;
}

.items-foot-label {
  font-size: 22rpx;
  color: #ab979c;
  margin-right: 12rpx;
}

.items-foot-num {
  font-size: 40rpx;
  color: #b25a6c;
  font-weight: 600;
}

.items-foot-unit {
  font-size: 21rpx;
  color: #ab979c;
  margin-left: 8rpx;
}

/* ---------- 口味 ---------- */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  color: #8d7a80;
  background: #fdf7f5;
  border-radius: 14rpx 14rpx 14rpx 4rpx;
  padding: 14rpx 26rpx;
  margin: 0 16rpx 16rpx 0;
  letter-spacing: 1rpx;
  box-shadow: inset 0 0 0 2rpx #f4e6e2;
}

.chip.chip-on {
  background: linear-gradient(135deg, #f2c6ce, #de8f9d);
  color: #ffffff;
  font-weight: 600;
  box-shadow: 0 8rpx 18rpx rgba(207, 111, 129, 0.24);
  transform: rotate(0deg);
}

.note-dash {
  margin: 8rpx 0 20rpx;
}

.note-input {
  width: 100%;
  min-height: 92rpx;
  font-size: 25rpx;
  color: #4a3a3e;
  line-height: 1.7;
  letter-spacing: 0.5rpx;
}

.note-ph {
  color: #c5b3b6;
  font-size: 24rpx;
}

.name-input {
  font-size: 28rpx;
  color: #43333a;
  height: 56rpx;
  letter-spacing: 1rpx;
}

/* ---------- 时间 ---------- */
.time-row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
}

.time-radio {
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  border: 3rpx solid #e6d2cd;
  margin-right: 22rpx;
  flex-shrink: 0;
}

.time-radio.on {
  border-color: #cf6f81;
  background: #cf6f81;
  box-shadow: inset 0 0 0 7rpx #fffdfb;
}

.time-text {
  flex: 1;
}

.time-main {
  font-size: 28rpx;
  color: #43333a;
  letter-spacing: 1rpx;
}

.time-sub {
  font-size: 21rpx;
  color: #ab979c;
  margin-top: 4rpx;
}

.time-pick {
  font-size: 32rpx;
  color: #ab979c;
  background: #fdf7f5;
  border-radius: 12rpx;
  padding: 10rpx 24rpx;
  letter-spacing: 1rpx;
}

.time-pick.active {
  color: #a8792f;
  background: linear-gradient(135deg, #fdf4e3, #f7ead2);
  font-weight: 600;
}

.time-dash {
  margin: 4rpx 0;
}

/* ---------- 底部 ---------- */
.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 247, 244, 0.97);
  box-shadow: 0 -10rpx 28rpx rgba(186, 130, 120, 0.1);
}

.bottom-inner {
  display: flex;
  align-items: center;
}

.sum {
  width: 190rpx;
}

.sum-num {
  font-size: 44rpx;
  color: #b25a6c;
  font-weight: 600;
  line-height: 1.1;
}

.sum-label {
  font-size: 20rpx;
  color: #ab979c;
  margin-top: 4rpx;
  letter-spacing: 1rpx;
}

.submit {
  flex: 1;
}

/* ---------- 下单成功：烛光 + 花瓣 ---------- */
.success {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 99;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: rgba(46, 32, 36, 0.42);
  animation: fadeIn 0.22s ease both;
}

.success-card {
  position: relative;
  z-index: 2;
  width: 520rpx;
  padding: 66rpx 40rpx 52rpx;
  text-align: center;
  background: #fffdfb;
  border-radius: 34rpx;
  box-shadow: 0 28rpx 64rpx rgba(46, 32, 36, 0.28);
  animation: pop 0.5s cubic-bezier(0.2, 1.3, 0.42, 1) both;
}

.success-title {
  font-size: 38rpx;
  color: #43333a;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.success-sub {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #a08a90;
  letter-spacing: 1rpx;
}

/* 蜡烛 */
.candle {
  position: relative;
  width: 34rpx;
  height: 104rpx;
  margin: 0 auto 34rpx;
}

.candle::before {
  content: "";
  position: absolute;
  left: 50%;
  margin-left: -64rpx;
  bottom: 44rpx;
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 186, 110, 0.5), rgba(255, 186, 110, 0) 66%);
  animation: glow 1.8s ease-in-out infinite;
}

.wax {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  border-radius: 8rpx 8rpx 6rpx 6rpx;
  background: linear-gradient(180deg, #fff8ef, #f2dcc4);
  box-shadow: inset -6rpx 0 10rpx rgba(190, 150, 120, 0.15);
}

.wax-drip {
  position: absolute;
  top: -2rpx;
  left: 50%;
  margin-left: -9rpx;
  width: 18rpx;
  height: 24rpx;
  background: #fff8ef;
  border-radius: 0 0 10rpx 10rpx;
}

.wick {
  position: absolute;
  left: 50%;
  margin-left: -2rpx;
  bottom: 70rpx;
  width: 4rpx;
  height: 12rpx;
  background: #8a6a52;
  border-radius: 2rpx;
}

.flame {
  position: absolute;
  left: 50%;
  margin-left: -11rpx;
  bottom: 80rpx;
  width: 22rpx;
  height: 34rpx;
  border-radius: 50% 50% 46% 46%;
  background: radial-gradient(circle at 50% 72%, #fff8c8, #ffb545 58%, #e2622f 100%);
  transform-origin: 50% 90%;
  animation: flicker 1.5s ease-in-out infinite;
}

/* 花瓣 */
.petal {
  position: absolute;
  top: -60rpx;
  border-radius: 62% 4% 62% 4%;
  background: linear-gradient(160deg, #fbd6de, #ec9cae);
  opacity: 0;
  animation-name: petalFall;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes pop {
  from { opacity: 0; transform: scale(0.86) translateY(20rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

@keyframes flicker {
  0%, 100% { transform: scale(1) rotate(-2deg); opacity: 0.95; }
  35% { transform: scale(1.12, 0.94) rotate(2deg); opacity: 1; }
  70% { transform: scale(0.94, 1.08) rotate(-1deg); opacity: 0.9; }
}

@keyframes glow {
  0%, 100% { opacity: 0.55; transform: scale(0.94); }
  50% { opacity: 1; transform: scale(1.06); }
}

@keyframes petalFall {
  0% {
    opacity: 0;
    transform: translate3d(0, -40rpx, 0) rotate(0deg);
  }
  10% {
    opacity: 0.95;
  }
  55% {
    opacity: 0.95;
    transform: translate3d(28rpx, 720rpx, 0) rotate(200deg);
  }
  100% {
    opacity: 0;
    transform: translate3d(-18rpx, 1560rpx, 0) rotate(400deg);
  }
}
