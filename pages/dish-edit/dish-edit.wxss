.page {
  padding: 0 24rpx 200rpx;
}

.head {
  padding: 36rpx 8rpx 24rpx;
}

.head-kicker {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #b25a6c;
  margin-bottom: 8rpx;
}

.kicker-star {
  color: #c9a063;
  margin-right: 10rpx;
}

.head-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #43333a;
  letter-spacing: 3rpx;
}

/* 配图 */
.pic {
  position: relative;
  width: 100%;
  height: 300rpx;
  border-radius: 26rpx;
  overflow: hidden;
  background: #fffdfb;
  box-shadow:
    0 10rpx 26rpx rgba(186, 130, 120, 0.1),
    inset 0 0 0 2rpx #f6e5e2;
}

.pic-img {
  width: 100%;
  height: 100%;
}

.pic-empty {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.pic-plus {
  font-size: 64rpx;
  color: #d9b8bf;
  line-height: 1;
}

.pic-tip {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b3a0a4;
  letter-spacing: 1rpx;
}

.pic-badge {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 8rpx 20rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(58, 44, 49, 0.6);
  border-radius: 999rpx;
}

/* 表单 */
.form {
  margin-top: 24rpx;
  background: #fffdfb;
  border-radius: 26rpx;
  padding: 8rpx 28rpx;
  box-shadow:
    0 10rpx 26rpx rgba(186, 130, 120, 0.09),
    inset 0 0 0 2rpx #f8ece8;
}

.field {
  display: flex;
  align-items: center;
  min-height: 100rpx;
  border-bottom: 2rpx solid #f7efe6;
}

.field:last-child {
  border-bottom: none;
}

.field-col {
  display: block;
  padding: 24rpx 0;
}

.field-col .label {
  display: block;
  width: auto;
  margin-bottom: 14rpx;
}

/* 点选标签 */
.chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  padding: 13rpx 26rpx;
  margin: 0 14rpx 14rpx 0;
  font-size: 25rpx;
  color: #8d7a80;
  background: #fdf7f5;
  border-radius: 14rpx 14rpx 14rpx 4rpx;
  letter-spacing: 1rpx;
  box-shadow: inset 0 0 0 2rpx #f4e6e2;
}

.chip-on {
  color: #ffffff;
  font-weight: 600;
  background: linear-gradient(135deg, #e29aa6, #b95d70);
  box-shadow: 0 8rpx 18rpx rgba(185, 93, 112, 0.26);
}

.chip:active {
  opacity: 0.85;
}

.label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 25rpx;
  color: #8d7a80;
  letter-spacing: 1rpx;
}

.input {
  flex: 1;
  font-size: 27rpx;
  color: #43333a;
  min-height: 60rpx;
}

.picker-val {
  font-size: 27rpx;
  color: #43333a;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #cbb9bd;
}

.area {
  width: 100%;
  min-height: 90rpx;
  font-size: 26rpx;
  color: #43333a;
  line-height: 1.6;
  margin-top: 12rpx;
}

.area-tall {
  min-height: 220rpx;
}

.ph {
  color: #c5b3b6;
  font-size: 25rpx;
}

.hint {
  margin-top: 10rpx;
  font-size: 20rpx;
  color: #b3a0a4;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 247, 244, 0.97);
  box-shadow: 0 -10rpx 28rpx rgba(186, 130, 120, 0.1);
}

/* 用于缩图的隐藏画布 */
.shrinker {
  position: fixed;
  left: -9999rpx;
  top: 0;
  width: 20rpx;
  height: 20rpx;
}
