.page {
  padding: 0 24rpx 190rpx;
}

.head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 36rpx 8rpx 24rpx;
}

.head-kicker {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #b25a6c;
  margin-bottom: 8rpx;
}

.kicker-star {
  color: #c9a063;
  margin-right: 10rpx;
}

.head-title {
  font-size: 46rpx;
  font-weight: 600;
  color: #43333a;
  letter-spacing: 3rpx;
}

.head-meta {
  font-size: 22rpx;
  color: #ab979c;
  margin-top: 8rpx;
}

.refresh {
  margin-top: 48rpx;
  font-size: 22rpx;
  color: #8d7a80;
  background: #fffdfb;
  border-radius: 999rpx;
  padding: 9rpx 22rpx;
  box-shadow: inset 0 0 0 2rpx #f4e6e2;
}

/* 菜系切换 */
.tabs {
  display: flex;
  flex-wrap: wrap;
  padding: 0 0 12rpx;
}

.tab {
  padding: 12rpx 22rpx;
  margin: 0 10rpx 14rpx 0;
  font-size: 24rpx;
  color: #8d7a80;
  background: #fffdfb;
  border-radius: 14rpx;
  box-shadow: inset 0 0 0 2rpx #f4e6e2;
}

.tab.on {
  color: #fff;
  background: linear-gradient(135deg, #e29aa6, #b95d70);
  box-shadow: none;
}

/* 列表行 */
.row {
  display: flex;
  align-items: center;
  padding: 18rpx;
  margin-bottom: 18rpx;
  background: #fffdfb;
  border-radius: 24rpx;
  box-shadow:
    0 10rpx 24rpx rgba(186, 130, 120, 0.09),
    inset 0 0 0 2rpx #f8ece8;
}

.row-off {
  opacity: 0.62;
}

.row-img {
  width: 132rpx;
  height: 132rpx;
  border-radius: 16rpx;
  background: #f6ece8;
  flex-shrink: 0;
}

.row-body {
  flex: 1;
  min-width: 0;
  padding-left: 18rpx;
}

.row-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #43333a;
  letter-spacing: 1rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.row-meta {
  font-size: 21rpx;
  color: #ab979c;
  margin-top: 6rpx;
}

.row-tags {
  margin-top: 10rpx;
}

.badge {
  display: inline-block;
  font-size: 18rpx;
  padding: 3rpx 12rpx;
  border-radius: 6rpx;
  margin-right: 8rpx;
  color: #4e7350;
  background: #e9f1e7;
}

.badge-off {
  color: #9c858c;
  background: #f1eaea;
}

.badge-ghost {
  color: #a8792f;
  background: #fdf4e3;
}

.row-ops {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  flex-shrink: 0;
}

.op {
  font-size: 21rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  letter-spacing: 1rpx;
}

.op-toggle {
  min-width: 92rpx;
  text-align: center;
}

.op-off {
  color: #b25a6c;
  background: #fdeff1;
}

.op-on {
  color: #fff;
  background: linear-gradient(135deg, #e29aa6, #b95d70);
}

.op-line {
  display: flex;
  margin-top: 10rpx;
}

.op-mini {
  width: 46rpx;
  height: 46rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: 22rpx;
  color: #8d7a80;
  background: #faf3ee;
  border-radius: 10rpx;
  margin-left: 8rpx;
}

.op-del {
  color: #c05a5a;
}

.build {
  padding: 28rpx 8rpx 10rpx;
  text-align: center;
  font-size: 19rpx;
  color: #c0aeb2;
  letter-spacing: 1rpx;
}

.build-dot {
  margin: 0 12rpx;
}

.bottom {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 247, 244, 0.97);
  box-shadow: 0 -10rpx 28rpx rgba(186, 130, 120, 0.1);
}
