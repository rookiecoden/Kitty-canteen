.page {
  padding-bottom: 210rpx;
}

/* ---------- 头图 ---------- */
.hero-wrap {
  position: relative;
  width: 100%;
  height: 620rpx;
  overflow: hidden;
  border-bottom-left-radius: 48rpx;
  border-bottom-right-radius: 48rpx;
}

.hero-img {
  width: 100%;
  height: 100%;
  background: #f6ece8;
}

.hero-ph {
  font-size: 150rpx;
  color: #c98a96;
  letter-spacing: 10rpx;
}

.hero-fade {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 320rpx;
  background: linear-gradient(to top, rgba(50, 32, 36, 0.78), rgba(50, 32, 36, 0));
}

.hero-caption {
  position: absolute;
  left: 40rpx;
  right: 40rpx;
  bottom: 42rpx;
  color: #fff;
}

.hero-kicker {
  font-size: 21rpx;
  letter-spacing: 5rpx;
  color: rgba(255, 244, 242, 0.86);
  margin-bottom: 12rpx;
}

.kicker-star {
  color: #f0cf9d;
  margin-right: 10rpx;
}

.hero-name {
  font-size: 58rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  line-height: 1.2;
}

.hero-desc {
  font-size: 24rpx;
  color: rgba(255, 246, 244, 0.8);
  margin-top: 12rpx;
  line-height: 1.6;
}

/* ---------- 三格数据便签 ---------- */
.body {
  padding: 0 24rpx 24rpx;
}

.stats {
  display: flex;
  margin: -34rpx 6rpx 0;
  position: relative;
  z-index: 2;
}

.stat {
  flex: 1;
  margin-right: 16rpx;
  padding: 26rpx 8rpx 22rpx;
  text-align: center;
  background: #fffdfb;
  border-radius: 22rpx;
  box-shadow:
    0 10rpx 24rpx rgba(186, 130, 120, 0.14),
    inset 0 0 0 2rpx #f8ece8;
}

.stat:last-child {
  margin-right: 0;
}

.stat.tilt-l {
  transform: rotate(-0.9deg) translateY(2rpx);
}

.stat.tilt-r {
  transform: rotate(0.9deg) translateY(-2rpx);
}

.stat-num {
  font-size: 42rpx;
  color: #43333a;
  line-height: 1.2;
}

.stat-unit {
  font-size: 22rpx;
  margin-left: 2rpx;
  color: #8d7a80;
}

.stat-num.hot {
  color: #cf6f81;
  font-size: 30rpx;
}

.stat-num.cool {
  color: #9c858c;
  font-size: 30rpx;
}

.stat-label {
  font-size: 21rpx;
  color: #ab979c;
  margin-top: 8rpx;
  letter-spacing: 1rpx;
}

/* ---------- 区块 ---------- */
.block {
  margin-top: 48rpx;
}

/* ---------- 食材（菜单点线） ---------- */
.ing-card {
  padding: 40rpx 32rpx 24rpx;
}

.ing-row {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.ing-name {
  font-size: 27rpx;
  color: #4a3a3e;
  letter-spacing: 1rpx;
}

.leader {
  flex: 1;
  height: 2rpx;
  margin: 0 16rpx;
  background-image: linear-gradient(90deg, #e6d2cd 0, #e6d2cd 50%, transparent 50%);
  background-size: 14rpx 2rpx;
  background-repeat: repeat-x;
}

.ing-amount {
  font-size: 25rpx;
  color: #b25a6c;
  letter-spacing: 0.5rpx;
}

.hint {
  font-size: 21rpx;
  color: #b3a0a4;
  margin-top: 16rpx;
  padding-left: 8rpx;
  letter-spacing: 0.5rpx;
}

/* ---------- 标签 ---------- */
.tags {
  display: flex;
  flex-wrap: wrap;
}

.tag-lg {
  font-size: 24rpx;
  color: #b25a6c;
  background: #fffdfb;
  border-radius: 999rpx;
  padding: 12rpx 28rpx;
  margin: 0 14rpx 14rpx 0;
  letter-spacing: 1rpx;
  box-shadow:
    0 6rpx 16rpx rgba(186, 130, 120, 0.1),
    inset 0 0 0 2rpx #f6e5e2;
}

/* ---------- 底部 ---------- */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 18rpx 26rpx calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(253, 247, 244, 0.97);
  box-shadow: 0 -10rpx 28rpx rgba(186, 130, 120, 0.1);
}

.bottom-inner {
  display: flex;
  align-items: center;
}

.bottom-cart {
  font-size: 24rpx;
  color: #8d7a80;
  margin-right: 22rpx;
  white-space: nowrap;
  letter-spacing: 1rpx;
}

.bottom-btn {
  flex: 1;
}
