.page {
  padding: 0 24rpx 70rpx;
  min-height: 100vh;
}

/* ---------- 页头 ---------- */
.head {
  padding: 40rpx 8rpx 24rpx;
}

.head-kicker {
  font-size: 21rpx;
  letter-spacing: 4rpx;
  color: #b25a6c;
  margin-bottom: 8rpx;
}

.kicker-star {
  color: #c9a063;
  margin-right: 10rpx;
}

.head-title {
  font-size: 50rpx;
  color: #43333a;
  letter-spacing: 3rpx;
  font-weight: 600;
}

.tip {
  font-size: 21rpx;
  color: #bcabae;
  text-align: center;
  padding: 6rpx 0 26rpx;
  letter-spacing: 1rpx;
}

/* ---------- 小票 ---------- */
.ticket {
  position: relative;
  padding: 26rpx 30rpx 24rpx;
  margin-bottom: 26rpx;
  background: #fffdfb;
  border-radius: 26rpx;
  box-shadow:
    0 12rpx 30rpx rgba(186, 130, 120, 0.1),
    inset 0 0 0 2rpx #f8ece8;
  animation: riseIn 0.45s ease both;
}

@keyframes riseIn {
  from {
    opacity: 0;
    transform: translateY(16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.ticket-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.when-day {
  font-size: 34rpx;
  color: #43333a;
  letter-spacing: 2rpx;
  font-weight: 600;
}

.when-time {
  font-size: 21rpx;
  color: #ab979c;
  margin-left: 12rpx;
}

/* 蜡封式状态 */
.stamp {
  flex-shrink: 0;
  padding: 8rpx 22rpx;
  font-size: 22rpx;
  letter-spacing: 1.5rpx;
  border-radius: 999rpx;
}

.stamp.pending {
  color: #a8792f;
  background: linear-gradient(135deg, #fdf4e3, #f7ead2);
  box-shadow: inset 0 0 0 2rpx #f0dbb5;
}

.stamp.cooking {
  color: #fff;
  background: linear-gradient(135deg, #e29aa6, #b95d70);
  box-shadow: 0 8rpx 16rpx rgba(185, 93, 112, 0.26);
}

.stamp.served {
  color: #5c7a5e;
  background: linear-gradient(135deg, #eef3ec, #dfe9dd);
  box-shadow: inset 0 0 0 2rpx #d3e0d0;
}

/* 撕口 */
.tear {
  position: relative;
  height: 2rpx;
  margin: 24rpx 0 20rpx;
  background-image: linear-gradient(90deg, #ead6d1 0, #ead6d1 55%, transparent 55%);
  background-size: 16rpx 2rpx;
  background-repeat: repeat-x;
}

.tear::before,
.tear::after {
  content: "";
  position: absolute;
  top: -15rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #fdf7f4;
  box-shadow: inset 0 0 0 2rpx #f8ece8;
}

.tear::before {
  left: -46rpx;
}

.tear::after {
  right: -46rpx;
}

/* 菜品行 */
.dashes {
  padding: 4rpx 0;
}

.dash-line {
  display: flex;
  align-items: baseline;
  padding: 7rpx 0;
}

.dash-star {
  font-size: 16rpx;
  color: #e0bfa4;
  margin-right: 14rpx;
}

.dash-text {
  font-size: 27rpx;
  color: #4a3a3e;
  letter-spacing: 1rpx;
}

.note {
  margin-top: 16rpx;
  padding: 14rpx 20rpx;
  font-size: 23rpx;
  line-height: 1.6;
  color: #a3662f;
  background: #fdf6ec;
  border-radius: 14rpx;
}

.note-quote {
  color: #d8b98f;
}

.ticket-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #f7ece7;
}

.meal {
  font-size: 22rpx;
  color: #8d7a80;
  letter-spacing: 0.5rpx;
}

.cal {
  font-size: 21rpx;
  color: #ab979c;
}

.ticket-no {
  margin-top: 12rpx;
  text-align: center;
  font-size: 18rpx;
  color: #e3d2ce;
  letter-spacing: 2rpx;
}
