<view class="page">

  <view class="head">
    <view class="head-kicker">
      <text class="kicker-star">✦</text>
      <text>点单小票</text>
    </view>
    <view class="head-title serif">我的单子</view>
  </view>

  <view class="state" wx:if="{{loading}}">
    <view class="state-emoji">🍳</view>
    <view class="state-text">正在问大厨…</view>
  </view>

  <view class="state" wx:elif="{{failed}}">
    <view class="state-emoji">📡</view>
    <view class="state-text">没连上，检查一下网络</view>
    <view class="state-btn" bindtap="retry">重新加载</view>
  </view>

  <block wx:elif="{{orders.length > 0}}">
    <view class="tip">下拉刷新，看大厨做到哪一步了</view>

    <view class="ticket" wx:for="{{orders}}" wx:key="id">
      <view class="ticket-top">
        <view class="when">
          <text class="when-day serif">{{item.dayText}}</text>
          <text class="when-time">{{item.createdText}} 下单</text>
        </view>
        <view class="stamp {{item.status}}">{{item.statusText}}</view>
      </view>

      <view class="tear"></view>

      <view class="dashes">
        <view class="dash-line" wx:for="{{item.names}}" wx:for-item="line" wx:key="*this">
          <text class="dash-star">✦</text>
          <text class="dash-text">{{line}}</text>
        </view>
      </view>

      <view class="note" wx:if="{{item.note}}">
        <text class="note-quote">「</text>{{item.note}}<text class="note-quote">」</text>
      </view>

      <view class="ticket-foot">
        <text class="meal">{{item.mealText}}</text>
        <text class="cal">共 {{item.count}} 份 · 约 {{item.calories}} kcal</text>
      </view>

      <view class="ticket-no">No.{{item.id}}</view>
    </view>
  </block>

  <view class="state" wx:else>
    <image class="illus" src="/assets/illus/empty-ticket.png" mode="aspectFit" />
    <view class="state-title">还没有点过菜</view>
    <view class="state-text">今天想吃点什么？</view>
    <view class="state-btn" bindtap="goMenu">去点菜</view>
  </view>

</view>
